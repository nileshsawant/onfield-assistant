# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Database / Models
vectordb/
models/
embedding_model/

# Per-site config (see site.example.toml). Kept out of git so `git pull`
# never clobbers a downstream install's overrides. Missing file falls
# back to Kestrel defaults hard-coded in src/ofa_site.py.
site.toml

# Install-generated artifacts (see install.sh). Regenerated on demand,
# per-install; must not be committed. (env/ and lib/ are already ignored
# under the Python section above; ollama's binary lives under bin/.)
env.sh
tools/modulefile.lua.template
bin/ollama

# Sphinx documentation build outputs (see docs/ + .github/workflows/docs.yml).
# _autosummary/ is autogenerated by sphinx-autosummary on every build.
docs/_build/
docs/_autosummary/

# RAG source repos. These are cloned per-install (via install.sh or by
# a maintainer) and can be large third-party trees — never track them.
# Individual small in-repo corpora (e.g. repos/vasp/) can be un-ignored
# with a negation pattern below.
repos/*
# ...but do track our small, hand-maintained corpora:
!repos/vasp/

# Ad-hoc migration / one-shot fix scripts left behind at the repo root
# during rapid iteration. Belong in a branch or gist, not in main.
/fix_*.py
/update_*.py
/loosen_*.py
/get_ollama_models.py
/commit_fix.sh

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
